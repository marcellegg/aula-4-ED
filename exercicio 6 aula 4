#include <iostream>
using namespace std;

int main() {
    const int size = 6;
    int n[size];

    cout << "Digite 6 numeros inteiros:" << endl;

    for (int i = 0; i < size; ++i) {
        cin >> n[i];
    }

    int menor = n[0];
    int maior = n[0];

    for (int i = 1; i < size; ++i) {
        if (n[i] < menor) {
            menor = n[i];
        }

        if (n[i] > maior) {
            maior = n[i];
        }
    }

    cout << "Menor numero: " << menor << endl;
    cout << "Maior numero: " << maior << endl;

    return 0;
}
